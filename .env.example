# Application
APP_NAME=BurnDrop
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
APP_SECRET=change-me-to-a-long-random-secret

# Database
DATABASE_URL=postgresql+asyncpg://burndrop:burndrop@postgres:5432/burndrop

# Redis
REDIS_URL=redis://redis:6379/0

# File limits
MAX_FILE_SIZE_MB=1024
FILE_EXPIRATION_HOURS=3
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Storage Backend Choice: local | google_drive | s3
STORAGE_BACKEND=s3

# AWS S3 Storage (Set STORAGE_BACKEND=s3 to activate)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Google Drive (Set STORAGE_BACKEND=google_drive to activate)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Email Configuration
EMAIL_FROM=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Frontend (public)
NEXT_PUBLIC_APP_NAME=BurnDrop
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAX_FILE_SIZE_MB=1024
NEXT_PUBLIC_FILE_EXPIRATION_HOURS=3
